			{
				"index": 73,
				"text": "Изменение концентрации препарата в органе при одноразовой инъекции в результате его переноса в кровь описывается уравнением:",
				"type": "single",
				"options": [
					{
						"index": 1,
						"text": "dN=-kNdt;",
						"isCorrect": true
					},
					{
						"index": 2,
						"text": "dN=kNdt;",
						"isCorrect": false
					},
					{
						"index": 3,
						"text": "dN=-kNo*dt;",
						"isCorrect": false
					},
					{
						"index": 4,
						"text": "dN/N=-kdtN.",
						"isCorrect": false
					}
				]
			},
			{
