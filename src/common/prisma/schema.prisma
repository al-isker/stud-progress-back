generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Student {
  id                  Int         @id @default(autoincrement())

  fullName            String      @unique @map("full_name")
  password            String
  course              Int
  semester            Int
  averageMark         Float?

  subjects            Subject[]

  @@map("student")
}

model Subject {
  id                 Int                @id @default(autoincrement())
  
  name               SubjectName        @relation(fields: [nameId], references: [id])
  nameId             Int
  controlType        ControlType?       @map("control_type")
  semesters          Semester[]
  grade              Grade?
  rating             Rating[]
  averageMark        Float?             @map("average_mark")
  
  student            Student            @relation(fields: [studentId], references: [id])
  studentId          Int                @map("student_id")

  @@map("subject")
  // his unique [name, ratingSemesters.number, studentId]
}

model SubjectName {
  id                 Int                @id @default(autoincrement())

  name               String             @unique

  subjects           Subject[]

  @@map("subject_name")
}

model Semester {
  id          Int        @id @default(autoincrement())

  number      Int

  subject     Subject    @relation(fields: [subjectId], references: [id])
  subjectId   Int        @map("subject_id")

  @@map("semester")
  @@unique([number, subjectId])
}

model Grade {
  id          Int           @id @default(autoincrement())

  date        DateTime?
  status      GradeStatus
  mark        Int?
  isNew       Boolean       @map("is_new")

  subject     Subject       @relation(fields: [subjectId], references: [id])
  subjectId   Int           @unique @map("subject_id")

  @@map("grade")
}

model Rating {
  id          Int            @id @default(autoincrement())

  date        DateTime
  status      RatingStatus
  mark        Int?
  isNew       Boolean        @map("is_new")

  subject     Subject        @relation(fields: [subjectId], references: [id])
  subjectId   Int            @map("subject_id")

  @@map("rating")
  @@unique([date, subjectId])
}

enum ControlType {
  TEST
  GRADED_TEST
  EXAM
}

enum GradeStatus {
  PASS
  FAIL
  EMPTY
}

enum RatingStatus {
  MARK
  EMPTY
  ABSENCE
  UPWORKED
  UPWORKED_WITH_MARK
}