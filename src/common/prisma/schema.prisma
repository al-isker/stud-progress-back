generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Student {
  id                  Int         @id @default(autoincrement())

  fullName            String      @unique @map("full_name")
  password            String
  course              Int
  semester            Int
  averageMark         Float?

  gradeUpdatedAt      DateTime?   @map("grade_updated_at")
  ratingUpdatedAt     DateTime?   @map("subjects_updated_at")
  subjects            Subject[]

  @@map("student")
}

model Subject {
  id          Int        @id @default(autoincrement())
    
  name        String
  semester    Int
  grade       Grade?
  rating      Rating[]
  
  student     Student    @relation(fields: [studentId], references: [id])
  studentId   Int        @map("student_id")

  @@map("subject")
  @@unique([name, studentId])
}

model Grade {
  id          Int        @id @default(autoincrement())

  type        String
  mark        String?
  date        DateTime
  isNew       Boolean    @default(true) @map("is_new")

  subject     Subject    @relation(fields: [subjectId], references: [id])
  subjectId   Int        @unique @map("subject_id")

  @@map("grade")
}

model Rating {
  id          Int        @id @default(autoincrement())

  mark        Int?
  status      RatingStatus
  date        DateTime
  isNew       Boolean    @default(true) @map("is_new")

  subject     Subject    @relation(fields: [subjectId], references: [id])
  subjectId   Int        @map("subject_id")

  @@map("rating")
  @@unique([date, subjectId])
}

enum RatingStatus {
  MARK
  EMPTY
  ABSENCE
  UPWORKED
  UPWORKED_WITH_MARK
}