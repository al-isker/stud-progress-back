generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id         Int        @id @default(autoincrement())
  full_name  String     @unique
  password   Int
  subjects   Subject[]
}

model Subject {
  id         Int     @id @default(autoincrement())
  title      String
  rating     Grade[]
  student    Student   @relation(fields: [studentId], references: [id])
  studentId  Int
}

enum Grade {
  Int 
  missed
}


